# Jev (TypeSafe AI) — System One Decision Engine
TYPESAFE_API_KEY=your-typesafe-api-key-here

# LLM Provider for deep analysis (Layer 3 — slow path)
# Supported: gemini, groq
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Groq (fallback)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# Proxy Settings
PROXY_PORT=8000
TARGET_BASE_URL=http://localhost:9000

# Circuit Breaker Thresholds (Layer 1 — deterministic hard ceiling)
HARD_CEILING_CALLS=20
HARD_CEILING_WINDOW_SECONDS=10
ANOMALY_THRESHOLD_CALLS=8
ANOMALY_THRESHOLD_WINDOW_SECONDS=5

# Confidence Thresholds (Layer 2 — Jev routing)
CONFIDENCE_HIGH=0.7
CONFIDENCE_LOW=0.4
ANOMALY_NOUL_THRESHOLD=0.5
SEVERITY_DANGEROUS=1.5
CLASSIFIER_TIMEOUT_MS=1000
